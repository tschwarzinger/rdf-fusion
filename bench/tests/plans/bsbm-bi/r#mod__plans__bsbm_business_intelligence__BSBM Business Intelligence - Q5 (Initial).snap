---
source: bench/tests/plans/bsbm_business_intelligence.rs
expression: "&explanation.initial_logical_plan.to_string()"
---
Projection: country AS country, product AS product, ENC_PT(nrOfReviews) AS nrOfReviews, ENC_PT(avgPrice) AS avgPrice
  Projection: country, product, nrOfReviews, avgPrice
    Sort: AS_SORTABLE_BYTES(nrOfReviews) DESC NULLS FIRST, AS_SORTABLE_BYTES(ENC_TF(country)) ASC NULLS FIRST, AS_SORTABLE_BYTES(ENC_TF(product)) ASC NULLS FIRST
      DecodeObjectIds: columns=[product]
        Filter: EBV(EQ(nrOfReviews, maxReviews))
          SparqlJoin: Inner 
            SparqlJoin: Inner 
              DecodeObjectIds: columns=[country]
                Projection: country, maxReviews
                  Extend: variable=?maxReviews, expression=<uuid>
                    Aggregate: groupBy=[[country AS country]], aggr=[[MAX(nrOfReviews) AS <uuid>]]
                      Projection: country, product, nrOfReviews
                        Extend: variable=?nrOfReviews, expression=<uuid>
                          Aggregate: groupBy=[[country AS country, product AS product]], aggr=[[COUNT(review) AS <uuid>]]
                            DecodeObjectIds: columns=[review]
                              BasicGraphPattern: 
                                QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType111>]
                                QuadPattern: triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> ?product]
                                QuadPattern: triple_pattern=[?review <http://purl.org/stuff/rev#reviewer> ?reviewer]
                                QuadPattern: triple_pattern=[?reviewer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/country> ?country]
              Projection: country, product, avgPrice
                Extend: variable=?avgPrice, expression=<uuid>
                  Aggregate: groupBy=[[Struct({term_type:,value:,data_type:,language_tag:}) AS country, product AS product]], aggr=[[AVG(xsd:float(xsd:string(ENC_TF(price)))) AS <uuid>]]
                    DecodeObjectIds: columns=[price]
                      BasicGraphPattern: 
                        QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType111>]
                        QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> ?product]
                        QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/price> ?price]
            DecodeObjectIds: columns=[country]
              Projection: country, product, nrOfReviews
                Extend: variable=?nrOfReviews, expression=<uuid>
                  Aggregate: groupBy=[[country AS country, product AS product]], aggr=[[COUNT(review) AS <uuid>]]
                    DecodeObjectIds: columns=[review]
                      BasicGraphPattern: 
                        QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType111>]
                        QuadPattern: triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> ?product]
                        QuadPattern: triple_pattern=[?review <http://purl.org/stuff/rev#reviewer> ?reviewer]
                        QuadPattern: triple_pattern=[?reviewer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/country> ?country]
