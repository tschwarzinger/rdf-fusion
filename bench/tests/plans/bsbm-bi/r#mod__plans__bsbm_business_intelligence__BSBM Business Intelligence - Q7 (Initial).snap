---
source: bench/tests/plans/bsbm_business_intelligence.rs
expression: "&explanation.initial_logical_plan.to_string()"
---
Projection: product
  Filter: EBV(BOOLEAN_AS_TERM(NOT EXISTS (<subquery>)))
    Subquery:
      Filter: outer_ref(product) = __inner__product
        Projection: offer AS __inner__offer, product AS __inner__product, vendor AS __inner__vendor, country AS __inner__country
          DecodeObjectIds: columns=[product]
            Filter: EBV(EQ(ENC_TF(country), ENC_TF(Struct({term_type:0,value:http://downlode.org/rdf/iso-3166/countries#US,data_type:,language_tag:}))))
              DecodeObjectIds: columns=[country]
                BasicGraphPattern: 
                  QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> ?product]
                  QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/vendor> ?vendor]
                  QuadPattern: triple_pattern=[?vendor <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/country> ?country]
    Limit: skip=0, fetch=1000
      Projection: product
        Sort: AS_SORTABLE_BYTES(offerCount) DESC NULLS FIRST
          DecodeObjectIds: columns=[product]
            Projection: product, offerCount
              Extend: variable=?offerCount, expression=<uuid>
                Aggregate: groupBy=[[product AS product]], aggr=[[COUNT(offer) AS <uuid>]]
                  DecodeObjectIds: columns=[offer]
                    BasicGraphPattern: 
                      QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1>]
                      QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> ?product]
