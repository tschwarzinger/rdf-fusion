---
source: bench/tests/plans/bsbm_business_intelligence.rs
expression: "&string"
---
ProjectionExec: expr=[productType@0 as productType, ENC_PT(reviewCount@1) as reviewCount]
  SortExec: TopK(fetch=10), expr=[AS_SORTABLE_BYTES(reviewCount@1) DESC, AS_SORTABLE_BYTES(ENC_TF(productType@0)) ASC], preserve_partitioning=[false]
    DecodeObjectIdsExec: projections=[decode(productType) as productType, reviewCount]
      AggregateExec: mode=Single, gby=[productType@0 as productType], aggr=[COUNT(review) as reviewCount]
        ProjectionExec: expr=[productType@1 as productType, review@0 as review]
          DecodeObjectIdsExec: projections=[decode(review) as review, productType]
            HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(productType@1, productType@0)], projection=[review@0, productType@1]
              HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(product@0, product@0)], projection=[review@1, productType@3]
                HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(reviewer@2, reviewer@0)], projection=[product@0, review@1]
                  HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@1, review@0)], projection=[product@0, review@1, reviewer@3]
                    HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(product@0, product@1)], projection=[product@0, review@1]
                      HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(producer@0, producer@1)], projection=[product@1]
                        ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?producer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/country> <http://downlode.org/rdf/iso-3166/countries#AT>], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as producer], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 14903 AND object@3 = 16436
                        ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?product <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/producer> ?producer], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as product, object@3 as producer], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 14904 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
                      ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> ?product], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as review, object@3 as product], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84986 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
                    ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://purl.org/stuff/rev#reviewer> ?reviewer], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as review, object@3 as reviewer], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84987 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
                  ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?reviewer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/country> <http://downlode.org/rdf/iso-3166/countries#US>], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as reviewer], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 14903 AND object@3 = 15597 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
                ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?productType], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as product, object@3 as productType], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 1609 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
              ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?productType <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/ProductType>], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as productType], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 1609 AND object@3 = 1615 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
