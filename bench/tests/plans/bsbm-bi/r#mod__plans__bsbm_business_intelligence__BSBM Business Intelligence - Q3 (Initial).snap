---
source: bench/tests/plans/bsbm_business_intelligence.rs
expression: "&explanation.initial_logical_plan.to_string()"
---
Projection: product AS product, ENC_PT(ratio) AS ratio
  Limit: skip=0, fetch=10
    Projection: product, ratio
      Sort: AS_SORTABLE_BYTES(DIV(xsd:float(monthCount), monthBeforeCount)) DESC NULLS FIRST, AS_SORTABLE_BYTES(ENC_TF(product)) ASC NULLS FIRST
        DecodeObjectIds: columns=[product]
          Extend: variable=?ratio, expression=DIV(xsd:float(monthCount), monthBeforeCount)
            SparqlJoin: Inner 
              Projection: product, monthCount
                Extend: variable=?monthCount, expression=<uuid>
                  Aggregate: groupBy=[[product AS product]], aggr=[[COUNT(review) AS <uuid>]]
                    DecodeObjectIds: columns=[review]
                      Filter: EBV(BOOLEAN_AS_TERM(EBV(GEQ(ENC_TF(date), ENC_TF(Struct({term_type:2,value:2007-10-10,data_type:http://www.w3.org/2001/XMLSchema#date,language_tag:})))) AND EBV(LT(ENC_TF(date), ENC_TF(Struct({term_type:2,value:2007-11-07,data_type:http://www.w3.org/2001/XMLSchema#date,language_tag:}))))))
                        DecodeObjectIds: columns=[date]
                          BasicGraphPattern: 
                            QuadPattern: triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> ?product]
                            QuadPattern: triple_pattern=[?review <http://purl.org/dc/elements/1.1/date> ?date]
              Projection: product, monthBeforeCount
                Extend: variable=?monthBeforeCount, expression=<uuid>
                  Filter: EBV(GT(<uuid>, ENC_TF(Struct({term_type:2,value:0,data_type:http://www.w3.org/2001/XMLSchema#integer,language_tag:}))))
                    Aggregate: groupBy=[[product AS product]], aggr=[[COUNT(review) AS <uuid>]]
                      DecodeObjectIds: columns=[review]
                        Filter: EBV(BOOLEAN_AS_TERM(EBV(GEQ(ENC_TF(date), ENC_TF(Struct({term_type:2,value:2007-09-12,data_type:http://www.w3.org/2001/XMLSchema#date,language_tag:})))) AND EBV(LT(ENC_TF(date), ENC_TF(Struct({term_type:2,value:2007-10-10,data_type:http://www.w3.org/2001/XMLSchema#date,language_tag:}))))))
                          DecodeObjectIds: columns=[date]
                            BasicGraphPattern: 
                              QuadPattern: triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> ?product]
                              QuadPattern: triple_pattern=[?review <http://purl.org/dc/elements/1.1/date> ?date]
