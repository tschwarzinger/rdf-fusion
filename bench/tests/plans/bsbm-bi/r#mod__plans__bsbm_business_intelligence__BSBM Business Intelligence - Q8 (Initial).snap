---
source: bench/tests/plans/bsbm_business_intelligence.rs
expression: "&explanation.initial_logical_plan.to_string()"
---
Projection: vendor AS vendor, ENC_PT(cheapExpensiveRatio) AS cheapExpensiveRatio
  Limit: skip=0, fetch=10
    Projection: vendor, cheapExpensiveRatio
      Extend: variable=?cheapExpensiveRatio, expression=DIV(xsd:float(belowAvg), offerCount)
        Sort: AS_SORTABLE_BYTES(DIV(xsd:float(belowAvg), offerCount)) DESC NULLS FIRST, AS_SORTABLE_BYTES(ENC_TF(vendor)) ASC NULLS FIRST
          DecodeObjectIds: columns=[vendor]
            SparqlJoin: Inner 
              Aggregate: groupBy=[[vendor AS vendor]], aggr=[[COUNT(offer) AS belowAvg]]
                DecodeObjectIds: columns=[offer]
                  Filter: EBV(LT(xsd:float(xsd:string(ENC_TF(price))), avgPrice))
                    DecodeObjectIds: columns=[price]
                      SparqlJoin: Inner 
                        BasicGraphPattern: 
                          QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType4>]
                          QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> ?product]
                          QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/vendor> ?vendor]
                          QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/price> ?price]
                        Aggregate: groupBy=[[product AS product]], aggr=[[AVG(xsd:float(xsd:string(ENC_TF(price)))) AS avgPrice]]
                          DecodeObjectIds: columns=[price]
                            BasicGraphPattern: 
                              QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType4>]
                              QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> ?product]
                              QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/vendor> ?vendor]
                              QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/price> ?price]
              Aggregate: groupBy=[[vendor AS vendor]], aggr=[[COUNT(offer) AS offerCount]]
                DecodeObjectIds: columns=[offer]
                  BasicGraphPattern: 
                    QuadPattern: triple_pattern=[?product <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType4>]
                    QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/product> ?product]
                    QuadPattern: triple_pattern=[?offer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/vendor> ?vendor]
