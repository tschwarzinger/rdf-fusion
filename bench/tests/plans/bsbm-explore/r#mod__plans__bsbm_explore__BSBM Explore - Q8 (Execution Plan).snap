---
source: bench/tests/plans/bsbm_explore.rs
expression: "&string"
---
SortExec: TopK(fetch=20), expr=[AS_SORTABLE_BYTES(ENC_TF(reviewDate@2)) DESC], preserve_partitioning=[false]
  ProjectionExec: expr=[title@1 as title, text@2 as text, reviewDate@3 as reviewDate, reviewer@4 as reviewer, reviewerName@5 as reviewerName, rating1@6 as rating1, rating2@7 as rating2, rating3@8 as rating3, rating4@9 as rating4]
    DecodeObjectIdsExec: projections=[decode(review) as review, decode(title) as title, text, decode(reviewDate) as reviewDate, decode(reviewer) as reviewer, decode(reviewerName) as reviewerName, decode(rating1) as rating1, decode(rating2) as rating2, decode(rating3) as rating3, decode(rating4) as rating4]
      FilterExec: EBV(LANGMATCHES(ENC_TF(LANG(text@2)), 3:{value:EN,language:}))
        DecodeObjectIdsExec: projections=[review, title, decode(text) as text, reviewDate, reviewer, reviewerName, rating1, rating2, rating3, rating4]
          HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@6, rating2@7, rating3@8, rating4@10]
            HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@6, rating2@7, rating3@9]
              HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@6, rating2@8]
                HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@7]
                  ProjectionExec: expr=[review@0 as review, title@2 as title, text@1 as text, reviewDate@3 as reviewDate, reviewer@4 as reviewer, reviewerName@5 as reviewerName]
                    HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(reviewer@4, reviewer@0)], projection=[review@0, text@1, title@2, reviewDate@3, reviewer@4, reviewerName@6]
                      HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@0, review@0)], projection=[review@0, text@1, title@2, reviewDate@3, reviewer@5]
                        HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@0, review@0)], projection=[review@0, text@1, title@2, reviewDate@4]
                          HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@0, review@0)], projection=[review@0, text@1, title@3]
                            HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@0, review@0)], projection=[review@0, text@2]
                              ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/dataFromProducer12/Product578>], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as review], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84986 AND object@3 = 19423
                              ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://purl.org/stuff/rev#text> ?text], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as review, object@3 as text], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84990 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
                            ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://purl.org/dc/elements/1.1/title> ?title], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.zstd.parquet]]}, projection=[subject@1 as review, object@3 as title], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84989 AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible
