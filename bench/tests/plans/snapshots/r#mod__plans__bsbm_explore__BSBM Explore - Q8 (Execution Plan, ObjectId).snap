---
source: bench/tests/plans/bsbm_explore.rs
expression: "&string"
---
SortExec: TopK(fetch=20), expr=[AS_SORTABLE_BYTES(ENC_TF(reviewDate@2)) DESC], preserve_partitioning=[false]
  ProjectionExec: expr=[title@1 as title, text@2 as text, reviewDate@3 as reviewDate, reviewer@4 as reviewer, reviewerName@5 as reviewerName, rating1@6 as rating1, rating2@7 as rating2, rating3@8 as rating3, rating4@9 as rating4]
    DecodeObjectIdsExec: projections=[decode(review) as review, decode(title) as title, text, decode(reviewDate) as reviewDate, decode(reviewer) as reviewer, decode(reviewerName) as reviewerName, decode(rating1) as rating1, decode(rating2) as rating2, decode(rating3) as rating3, decode(rating4) as rating4]
      FilterExec: EBV(LANGMATCHES(ENC_TF(LANG(text@2)), 2:{value:EN,language:}))
        DecodeObjectIdsExec: projections=[review, title, decode(text) as text, reviewDate, reviewer, reviewerName, rating1, rating2, rating3, rating4]
          HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@6, rating2@7, rating3@8, rating4@10]
            HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@6, rating2@7, rating3@9]
              HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@6, rating2@8]
                HashJoinExec: mode=CollectLeft, join_type=Left, on=[(review@0, review@0)], projection=[review@0, title@1, text@2, reviewDate@3, reviewer@4, reviewerName@5, rating1@7]
                  ProjectionExec: expr=[review@2 as review, title@5 as title, text@3 as text, reviewDate@4 as reviewDate, reviewer@0 as reviewer, reviewerName@1 as reviewerName]
                    HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@2, review@0)], projection=[reviewer@0, reviewerName@1, review@2, text@3, reviewDate@4, title@6]
                      HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@2, review@0)], projection=[reviewer@0, reviewerName@1, review@2, text@3, reviewDate@5]
                        HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@2, review@0)], projection=[reviewer@0, reviewerName@1, review@2, text@4]
                          HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(review@2, review@0)], projection=[reviewer@0, reviewerName@1, review@2]
                            HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(reviewer@0, reviewer@1)], projection=[reviewer@0, reviewerName@1, review@2]
                              ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?reviewer <http://xmlns.com/foaf/0.1/name> ?reviewerName], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.parquet]]}, projection=[subject@1 as reviewer, object@3 as reviewerName], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84984, pruning_predicate=graph_null_count@0 > 0 AND predicate_null_count@3 != row_count@4 AND predicate_min@1 <= 84984 AND 84984 <= predicate_max@2, required_guarantees=[predicate in (84984)]
                              ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://purl.org/stuff/rev#reviewer> ?reviewer], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.parquet]]}, projection=[subject@1 as review, object@3 as reviewer], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84987 AND DynamicFilter [ empty ], pruning_predicate=graph_null_count@0 > 0 AND predicate_null_count@3 != row_count@4 AND predicate_min@1 <= 84987 AND 84987 <= predicate_max@2, required_guarantees=[predicate in (84987)]
                            ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/reviewFor> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/dataFromProducer12/Product578>], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.parquet]]}, projection=[subject@1 as review], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84986 AND object@3 = 19423 AND DynamicFilter [ empty ], pruning_predicate=graph_null_count@0 > 0 AND predicate_null_count@3 != row_count@4 AND predicate_min@1 <= 84986 AND 84986 <= predicate_max@2 AND object_null_count@7 != row_count@4 AND object_min@5 <= 19423 AND 19423 <= object_max@6, required_guarantees=[object in (19423), predicate in (84986)]
                          ParquetQuadScanExec: active_graph=Default Graph, triple_pattern=[?review <http://purl.org/stuff/rev#text> ?text], blank_node_mode=Variable, file_groups={1 group: [[databases/bsbm-1000/quad-tables/GPOS/delta-parquet-file.parquet]]}, projection=[subject@1 as review, object@3 as text], file_type=parquet, predicate=graph@0 IS NULL AND predicate@2 = 84990 AND DynamicFilter [ empty ], pruning_predicate=graph_null_count@0 > 0 AND predicate_null_count@3 != row_count@4 AND predicate_min@1 <= 84990 AND 84990 <= predicate_max@2, required_guarantees=[predicate in (84990)]
