set shell := ["bash", "-c"]
set unstable := true

prepare-benches-tests: (prepare-bsbm "1000")
    @echo "BSBM use cases share the data"

prepare-benches: (prepare-bsbm "10000") (prepare-dblp "100k") (prepare-dblp "1m")
    @echo "BSBM use cases share the data"

# Prepares the BSBM Explore benchmarks
prepare-bsbm num_products:
    #!/usr/bin/env bash
    set -e

    num_products="{{ num_products }}"
    DATA_DIR="data/bsbm-${num_products}"

    echo "Cleaning and creating directory $DATA_DIR ..."

    # Clean and recreate data directory
    rm -rf "$DATA_DIR"
    mkdir -p "$DATA_DIR"

    if [ "$num_products" = "1000" ]; then
        echo "Downloading pre-built dataset for 1000 products..."
        curl -sSL "https://rdf-fusion-public.b-cdn.net/rdf-fusion-public/ci/bsbm-1000.zip" -o "$DATA_DIR/bsbm-1000.zip"
        unzip -q -o "$DATA_DIR/bsbm-1000.zip" -d "$DATA_DIR"
        rm "$DATA_DIR/bsbm-1000.zip"
    else
        # 1. Download BSBM tools
        echo "Downloading BSBM tools..."
        curl -sSL "https://github.com/Tpt/bsbm-tools/archive/59d0a8a605b26f21506789fa1a713beb5abf1cab.zip" -o "$DATA_DIR/bsbm-tools.zip"
        unzip -q -o "$DATA_DIR/bsbm-tools.zip" -d "$DATA_DIR"
        mv "$DATA_DIR/bsbm-tools-59d0a8a605b26f21506789fa1a713beb5abf1cab" "$DATA_DIR/bsbmtools"
        rm "$DATA_DIR/bsbm-tools.zip"

        # 2. Generate dataset
        echo "Generating BSBM dataset for $num_products products..."
        cd "$DATA_DIR/bsbmtools"
        ./generate -fc -pc "$num_products" -dir ../td_data -fn ../dataset
        cd - > /dev/null

        # 3. Copy pre-generated queries
        echo "Copying explore queries..."
        bzcat "bench_files/bsbm_queries/explore-${num_products}.csv.bz2" > "$DATA_DIR/queries-explore.csv"
        echo "Copying BI queries..."
        bzcat "bench_files/bsbm_queries/businessIntelligence-${num_products}.csv.bz2" > "$DATA_DIR/queries-bi.csv"
    fi

    echo "Benchmarks prepared."

# Prepares a prefix of the dblp RDF dump with `size` triples (e.g., 100k, 1m, 10m, 100m).
#
# Only the required prefix of the monthly release is downloaded, such that the subsets are
# reproducible.
prepare-dblp size release="2026-09-01":
    #!/usr/bin/env bash
    set -eo pipefail

    size="{{ size }}"
    case "${size,,}" in
        *k) num_triples=$(( ${size%[kK]} * 1000 )) ;;
        *m) num_triples=$(( ${size%[mM]} * 1000000 )) ;;
        *) num_triples="$size" ;;
    esac

    DATA_DIR="data/dblp-${size,,}"
    if [ -f "$DATA_DIR/dblp.nt" ] && [ "$(wc -l < "$DATA_DIR/dblp.nt")" -eq "$num_triples" ]; then
        echo "$DATA_DIR/dblp.nt is already prepared."
        exit 0
    fi
    mkdir -p "$DATA_DIR"
    year="{{ release }}"
    url="https://drops.dagstuhl.de/storage/artifacts/dblp/rdf/${year%%-*}/dblp-{{ release }}.nt.gz"

    # The download below cannot detect HTTP errors (see below), so check the release up front.
    if ! curl -fsSLI -o /dev/null "$url"; then
        echo "The dblp release {{ release }} is not available at $url." >&2
        exit 1
    fi

    echo "Downloading the first $num_triples triples of $url ..."
    # `head` closes the pipe once it has enough lines, which aborts the download. Hence, errors of
    # the download are ignored and an incomplete download is detected by the check below.
    (curl -sL "$url" || true) | (gzip -dc 2>/dev/null || true) \
        | (grep -v '^$' || true) | head -n "$num_triples" > "$DATA_DIR/dblp.nt"

    actual=$(wc -l < "$DATA_DIR/dblp.nt")
    if [ "$actual" -ne "$num_triples" ]; then
        echo "Expected $num_triples triples, but got $actual." >&2
        exit 1
    fi
    echo "Prepared $DATA_DIR/dblp.nt."

# Executes the BSBM Explore benchmark against Parquet files with multiple sort orders.
bench-bsbm-explore num_products="10000" max_query_count="" parallel_tasks="" sort_orders="Native(SPO) Native(POS) Native(OSP)":
    #!/usr/bin/env bash
    set -e

    num_products="10000"
    max_query_count=""
    parallel_tasks=""
    sort_orders="Native(SPO) Native(POS) Native(OSP)"

    args=("{{ num_products }}" "{{ max_query_count }}" "{{ parallel_tasks }}" "{{ sort_orders }}")

    if [[ "${args[0]}" == *=* ]]; then
        for arg in "${args[@]}"; do
            if [[ "$arg" == *=* ]]; then
                key="${arg%%=*}"
                value="${arg#*=}"
                declare "$key"="$value"
            fi
        done
    else
        num_products="${args[0]}"
        max_query_count="${args[1]}"
        parallel_tasks="${args[2]}"
        sort_orders="${args[3]}"
    fi

    export DATAFUSION_EXECUTION_TARGET_PARTITIONS=1
    export DATAFUSION_EXECUTION_PARQUET_PUSHDOWN_FILTERS=true
    export DATAFUSION_EXPLAIN_SHOW_STATISTICS=true
    if [ -n "$parallel_tasks" ]; then
      export RDF_FUSION_BENCH_MAX_PARALLEL_TASKS=$parallel_tasks
    fi
    export RDF_FUSION_BENCH_VERBOSE_RESULTS=true

    EXTRA_ARGS=""
    if [ -n "$max_query_count" ]; then
        EXTRA_ARGS="--max-query-count $max_query_count"
    fi

    # Use read to safely split the sort orders string into an array, avoiding issues with parentheses
    IFS=' ' read -r -a ORDERS_ARRAY <<< "$sort_orders"

    for ORDER in "${ORDERS_ARRAY[@]}"; do
        echo "================================================================================"
        echo "Running BSBM Explore(num_products=$num_products) with sort order: $ORDER"
        echo "================================================================================"

        # Create a postfix by replacing '(' with '-' and removing ')'
        POSTFIX=$(echo "$ORDER" | tr '[:upper:]' '[:lower:]' | sed 's/(/-/g' | sed 's/)//g')

        export RDF_FUSION_BENCH_RESULTS_POSTFIX="$POSTFIX"
        export RDF_FUSION_STORAGE_PARQUET_SORT_ORDERS="$ORDER"
        cargo run --profile profiling-nonlto -- \
            execute \
            --storage-type parquet \
            --storage-encoding string \
            bsbm-explore \
            --num-products $num_products \
            $EXTRA_ARGS

        echo -e "\nFinished $ORDER.\n"
    done
