@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix :      <https://codeberg.org/tschwarzinger/rdf-fusion/raw/branch/main/testsuite/rdf-fusion-tests/sparql/manifest.ttl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:    <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix qt:    <http://www.w3.org/2001/sw/DataAccess/tests/test-query#> .
@prefix ut:    <http://www.w3.org/2009/sparql/tests/test-update#> .

<>  rdf:type mf:Manifest ;
    rdfs:label "RDF Fusion SPARQL tests" ;
    mf:entries
    (
        :complex_expression_in_order_by
        :order_by_aggregate_alias
        :filter_not_exists_with_inner_filter
        :filter_not_exists_with_labeled_blank_node
    ) .

:complex_expression_in_order_by rdf:type mf:QueryEvaluationTest ;
    mf:name "A SPARQL query with a complex expression in the ORDER BY clause" ;
    mf:action
         [ qt:query  <complex_expression_in_order_by.rq> ;
           qt:data   <complex_expression_in_order_by.ttl> ] ;
    mf:result  <complex_expression_in_order_by.srx> .

:order_by_aggregate_alias rdf:type mf:QueryEvaluationTest ;
    mf:name "A SPARQL query with an aggregate alias in the ORDER BY clause" ;
    mf:action
         [ qt:query  <order_by_aggregate_alias.rq> ;
           qt:data   <order_by_aggregate_alias.ttl> ] ;
    mf:result  <order_by_aggregate_alias.srx> .

:filter_not_exists_with_inner_filter rdf:type mf:QueryEvaluationTest ;
    mf:name "A SPARQL query with a FILTER NOT EXISTS that contains a FILTER on a correlated variable" ;
    mf:action
         [ qt:query  <filter_not_exists_with_inner_filter.rq> ;
           qt:data   <filter_not_exists_with_inner_filter.ttl> ] ;
    mf:result  <filter_not_exists_with_inner_filter.srx> .

:filter_not_exists_with_labeled_blank_node rdf:type mf:QueryEvaluationTest ;
    mf:name "A SPARQL query with a FILTER NOT EXISTS that contains a labeled blank node" ;
    mf:action
         [ qt:query  <filter_not_exists_with_labeled_blank_node.rq> ;
           qt:data   <filter_not_exists_with_labeled_blank_node.ttl> ] ;
    mf:result  <filter_not_exists_with_labeled_blank_node.srx> .
