PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?id ?nodeType ?target
WHERE {
    ?id owl:complementOf ?target .
    FILTER NOT EXISTS {
        ?named rdfs:subClassOf ?id .
        FILTER(!isIRI(?id))
    }
    BIND(owl:complementOf AS ?nodeType)
}
