Variant: Select
Projection: title, price
  SparqlJoin: Left 
    QuadPattern: triple_pattern=[?book <http://purl.org/dc/elements/1.1/title> ?title]
    Filter: EBV(EQ(ENC_TF(Struct({term_type:,value:,data_type:,language_tag:})), ENC_TF(Struct({term_type:2,value:TITLE 2,data_type:http://www.w3.org/2001/XMLSchema#string,language_tag:}))))
      QuadPattern: triple_pattern=[?book <http://example.org/ns#price> ?price]
