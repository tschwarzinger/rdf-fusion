        Filter: EBV(BOOLEAN_AS_TERM(EBV(BOOLEAN_AS_TERM(EBV(EQ(ENC_TF(a), ENC_TF(Struct({term_type:0,value:http://example.org/s1,data_type:,language_tag:})))) OR EBV(EQ(ENC_TF(a), ENC_TF(Struct({term_type:0,value:http://example.org/s3,data_type:,language_tag:})))))) AND EBV(BOOLEAN_AS_TERM(EBV(EQ(ENC_TF(b), ENC_TF(Struct({term_type:0,value:http://example.org/s1,data_type:,language_tag:})))) OR EBV(EQ(ENC_TF(b), ENC_TF(Struct({term_type:0,value:http://example.org/s3,data_type:,language_tag:}))))))))
          BasicGraphPattern: 
            QuadPattern: triple_pattern=[?a <http://example.org/str> ?s1]
            QuadPattern: triple_pattern=[?b <http://example.org/str> ?s2]
