              QuadPattern: triple_pattern=[?s1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Set>]
              QuadPattern: triple_pattern=[?s2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example/Set>]
